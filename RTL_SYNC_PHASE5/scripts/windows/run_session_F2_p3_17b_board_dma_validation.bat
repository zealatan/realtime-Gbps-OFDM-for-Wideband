@echo off
rem run_session_F2_p3_17b_board_dma_validation.bat — P3-17B Board DMA Replay Validation
rem
rem Builds and runs the Phase3 board DMA replay validation on the Zynq target
rem using Vitis xsct.  Extends the P3-17A smoke test with structured failure
rem classification and tight algorithm tolerance checks.
rem
rem BOARD_GATE outputs:
rem   BOARD_GATE: PASS             all 17 checks pass
rem   BOARD_GATE: PARTIAL_PASS     AXI+DMA pass, algorithm observables out of tolerance
rem   BOARD_GATE: FAIL_AXI         AXI-Lite register checks failed
rem   BOARD_GATE: FAIL_DMA         DMA setup or start failed
rem   BOARD_GATE: FAIL_DEADLOCK    DMA started but never completed
rem   BOARD_GATE: FAIL_RESET       Reset did not complete or ERROR_FLAGS set
rem   BOARD_GATE: FAIL_TIMING      Beat count mismatch (INPUT/OUTPUT_COUNT)
rem
rem Prerequisites:
rem   1. Vivado + Vitis 2022.2 or 2023.1 installed; paths set below.
rem   2. Board connected via USB-JTAG (ZC702 or equivalent ZC7020).
rem   3. Phase3 bitstream programmed, or set --program to load it here.
rem   4. XSA exported from Vivado (File > Export > Export Hardware, include bitstream).
rem
rem Usage:
rem   run_session_F2_p3_17b_board_dma_validation.bat [OPTIONS]
rem
rem Options:
rem   --program     program bitstream via xsct before running
rem   --build-only  compile ELF only, do not connect to board
rem   --timeout N   board run timeout in ms (default 60000)

setlocal EnableDelayedExpansion

rem ---------------------------------------------------------------------------
rem Configuration — UPDATE THESE for your environment
rem ---------------------------------------------------------------------------
set VITIS_ROOT=C:\Xilinx\Vitis\2023.1
set XSA_PATH=%~dp0..\..\vivado\phase3_wrapper.xsa
set BIT_FILE=%~dp0..\..\vivado\phase3_wrapper.bit
set WS_DIR=%~dp0..\..\vitis\workspace_p3_17b
set APP_NAME=session_F2_p3_17b_board_dma_validation
set APP_SRC=%~dp0..\..\vitis\session_F2_p3_17b_board_dma_validation.c

rem standalone_ps7_cortexa9_0  for Zynq-7000 (ZC702 / ZC7020)
rem standalone_psu_cortexa53_0 for Zynq UltraScale+
set BSP_PROC=standalone_ps7_cortexa9_0

set PROGRAM_BITSTREAM=0
set BUILD_ONLY=0
set RUN_TIMEOUT_MS=60000

rem ---------------------------------------------------------------------------
rem Parse arguments
rem ---------------------------------------------------------------------------
:parse_args
if "%1"=="--program"    set PROGRAM_BITSTREAM=1 & shift & goto parse_args
if "%1"=="--build-only" set BUILD_ONLY=1        & shift & goto parse_args
if "%1"=="--timeout"    shift & set RUN_TIMEOUT_MS=%1 & shift & goto parse_args
if not "%1"=="" (
    echo Unknown argument: %1
    exit /b 1
)

rem ---------------------------------------------------------------------------
rem Validate environment
rem ---------------------------------------------------------------------------
set XSCT=%VITIS_ROOT%\bin\xsct.bat
if not exist "%XSCT%" (
    echo ERROR: xsct not found at %XSCT%
    echo        Set VITIS_ROOT to your Vitis installation directory.
    exit /b 1
)

if not exist "%XSA_PATH%" (
    echo ERROR: XSA file not found: %XSA_PATH%
    echo        Export hardware from Vivado: File ^> Export ^> Export Hardware
    echo        ^(check "Include bitstream"^)
    exit /b 1
)

if not exist "%APP_SRC%" (
    echo ERROR: Application source not found: %APP_SRC%
    exit /b 1
)

echo ========================================================
echo P3-17B Board DMA Replay Validation
echo   VITIS_ROOT  : %VITIS_ROOT%
echo   XSA_PATH    : %XSA_PATH%
echo   Workspace   : %WS_DIR%
echo   App source  : %APP_SRC%
echo   Run timeout : %RUN_TIMEOUT_MS% ms
echo ========================================================
echo.

rem ---------------------------------------------------------------------------
rem Generate xsct TCL build+run script
rem ---------------------------------------------------------------------------
set TCL_SCRIPT=%TEMP%\p3_17b_run_%RANDOM%.tcl

(
    echo # Auto-generated by run_session_F2_p3_17b_board_dma_validation.bat
    echo set ws_dir        {%WS_DIR%}
    echo set xsa_path      {%XSA_PATH%}
    echo set bit_file      {%BIT_FILE%}
    echo set app_name      {%APP_NAME%}
    echo set app_src       {%APP_SRC%}
    echo set bsp_proc      {%BSP_PROC%}
    echo set prog_bit      %PROGRAM_BITSTREAM%
    echo set build_only    %BUILD_ONLY%
    echo set run_timeout   %RUN_TIMEOUT_MS%
    echo.
    echo # ------------------------------------
    echo # Workspace and platform setup
    echo # ------------------------------------
    echo setws $ws_dir
    echo.
    echo set plat_name phase3_p3_17b_platform
    echo catch {platform list}
    echo set existing_platforms [platform list]
    echo if {[lsearch -exact $existing_platforms $plat_name] == -1} {
    echo     puts "Creating platform: $plat_name"
    echo     platform create -name $plat_name -hw $xsa_path
    echo     platform active $plat_name
    echo     domain create -name $bsp_proc -os standalone -proc $bsp_proc
    echo     platform generate
    echo } else {
    echo     puts "Using existing platform: $plat_name"
    echo     platform active $plat_name
    echo }
    echo.
    echo # ------------------------------------
    echo # Application setup
    echo # ------------------------------------
    echo catch {app list}
    echo set existing_apps [app list]
    echo if {[lsearch -exact $existing_apps $app_name] == -1} {
    echo     puts "Creating application: $app_name"
    echo     app create -name $app_name -template {Empty Application} \
    echo                -platform $plat_name -domain $bsp_proc
    echo     file copy -force $app_src $ws_dir/$app_name/src/
    echo } else {
    echo     puts "Updating source for: $app_name"
    echo     file copy -force $app_src $ws_dir/$app_name/src/
    echo }
    echo.
    echo # ------------------------------------
    echo # Build
    echo # ------------------------------------
    echo puts "--- Building $app_name ---"
    echo app build -name $app_name
    echo set elf_path "$ws_dir/$app_name/Debug/${app_name}.elf"
    echo if {![file exists $elf_path]} {
    echo     puts "ERROR: ELF not found after build: $elf_path"
    echo     exit 1
    echo }
    echo puts "Build OK: $elf_path"
    echo.
    echo if {$build_only} {
    echo     puts "BUILD_ONLY mode — not connecting to board."
    echo     exit 0
    echo }
    echo.
    echo # ------------------------------------
    echo # Connect to board
    echo # ------------------------------------
    echo puts "--- Connecting to board ---"
    echo connect
    echo targets -set -filter {jtag_device_ctx ne ""} -index 0
    echo.
    echo if {$prog_bit && [file exists $bit_file]} {
    echo     puts "Programming bitstream: $bit_file"
    echo     fpga -file $bit_file
    echo     after 2000
    echo }
    echo.
    echo # Select first Cortex-A9/A53 core
    echo targets -set -filter {name =~ "*A9*0" || name =~ "*A53*0"}
    echo rst -system
    echo after 500
    echo.
    echo # ------------------------------------
    echo # Load ELF and run
    echo # ------------------------------------
    echo puts "--- Loading $elf_path ---"
    echo dow $elf_path
    echo puts "--- Running validation (timeout: ${run_timeout} ms) ---"
    echo con
    echo after $run_timeout
    echo stop
    echo puts ""
    echo puts "=== End of board output ==="
    echo disconnect
    echo exit 0
) > "%TCL_SCRIPT%"

rem ---------------------------------------------------------------------------
rem Run xsct
rem ---------------------------------------------------------------------------
echo --- Running xsct ---
call "%XSCT%" "%TCL_SCRIPT%"
set XSCT_RC=%ERRORLEVEL%
del /f /q "%TCL_SCRIPT%" 2>nul

echo.
if %XSCT_RC% neq 0 (
    echo ERROR: xsct exited with code %XSCT_RC%
    echo        Check JTAG connection, XSA path, and that the bitstream is loaded.
    exit /b %XSCT_RC%
)

if "%BUILD_ONLY%"=="1" (
    echo Build complete. ELF: %WS_DIR%\%APP_NAME%\Debug\%APP_NAME%.elf
    exit /b 0
)

echo ========================================================
echo Look for BOARD_GATE: PASS or BOARD_GATE: FAIL_* above.
echo.
echo If output is missing:
echo   - Increase --timeout (current: %RUN_TIMEOUT_MS% ms)
echo   - Confirm JTAG target was selected correctly
echo   - Check that the Phase3 bitstream is programmed
echo ========================================================
exit /b 0
