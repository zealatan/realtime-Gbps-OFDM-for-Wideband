@echo off
rem run_session_F_p3_17a_phase3_smoke.bat — P3-17A Board Smoke
rem
rem Builds and runs the Phase3 board smoke test on the Zynq/Zynq-UltraScale+ target
rem using the Vitis command-line tools (xsct).
rem
rem Prerequisites:
rem   1. Vivado + Vitis installed (tested with 2023.1 / 2022.2).
rem      Both must be on PATH, or set VITIS_ROOT below.
rem   2. Board connected via USB-JTAG.
rem   3. Phase3 bitstream programmed (via Vivado hardware manager, or set
rem      PROGRAM_BITSTREAM=1 to have this script do it via xsct).
rem   4. XSA file exported from Vivado (see XSA_PATH below).
rem
rem Usage:
rem   run_session_F_p3_17a_phase3_smoke.bat [--program] [--build-only]
rem
rem   --program     : program bitstream before running (requires BIT_FILE)
rem   --build-only  : compile application but do not run on board

setlocal EnableDelayedExpansion

rem ---------------------------------------------------------------------------
rem Configuration — UPDATE THESE for your environment
rem ---------------------------------------------------------------------------
set VITIS_ROOT=C:\Xilinx\Vitis\2023.1
set XSA_PATH=%~dp0..\..\vivado\phase3_wrapper.xsa
set BIT_FILE=%~dp0..\..\vivado\phase3_wrapper.bit
set WS_DIR=%~dp0..\..\vitis\workspace_p3_17a
set APP_NAME=session_F_p3_17a_phase3_smoke
set APP_SRC=%~dp0..\..\vitis\session_F_p3_17a_phase3_smoke.c

rem Target: standalone_ps7_cortexa9_0  for Zynq-7000
rem         standalone_psu_cortexa53_0 for Zynq UltraScale+
set BSP_PROC=standalone_ps7_cortexa9_0

rem Set 1 to program bitstream before running
set PROGRAM_BITSTREAM=0
set BUILD_ONLY=0

rem ---------------------------------------------------------------------------
rem Parse arguments
rem ---------------------------------------------------------------------------
:parse_args
if "%1"=="--program"    set PROGRAM_BITSTREAM=1 & shift & goto parse_args
if "%1"=="--build-only" set BUILD_ONLY=1       & shift & goto parse_args

rem ---------------------------------------------------------------------------
rem Validate environment
rem ---------------------------------------------------------------------------
set XSCT=%VITIS_ROOT%\bin\xsct.bat
if not exist "%XSCT%" (
    echo ERROR: xsct not found at %XSCT%
    echo        Set VITIS_ROOT to your Vitis installation directory.
    exit /b 1
)

if not exist "%XSA_PATH%" (
    echo ERROR: XSA file not found: %XSA_PATH%
    echo        Export hardware from Vivado: File ^> Export ^> Export Hardware ^(include bitstream^)
    exit /b 1
)

if not exist "%APP_SRC%" (
    echo ERROR: Application source not found: %APP_SRC%
    exit /b 1
)

echo === P3-17A Phase3 Board Smoke ===
echo   VITIS_ROOT  : %VITIS_ROOT%
echo   XSA_PATH    : %XSA_PATH%
echo   Workspace   : %WS_DIR%
echo   App source  : %APP_SRC%
echo.

rem ---------------------------------------------------------------------------
rem Build via xsct TCL script
rem ---------------------------------------------------------------------------
set TCL_SCRIPT=%TEMP%\p3_17a_build_%RANDOM%.tcl
(
    echo # Auto-generated by run_session_F_p3_17a_phase3_smoke.bat
    echo set ws_dir   {%WS_DIR%}
    echo set xsa_path {%XSA_PATH%}
    echo set bit_file {%BIT_FILE%}
    echo set app_name {%APP_NAME%}
    echo set app_src  {%APP_SRC%}
    echo set bsp_proc {%BSP_PROC%}
    echo set prog_bit  %PROGRAM_BITSTREAM%
    echo set build_only %BUILD_ONLY%
    echo.
    echo # Create workspace if needed
    echo setws $ws_dir
    echo.
    echo # Create platform from XSA
    echo set plat_name phase3_platform
    echo if {[catch {platform list} err]} {}
    echo set existing_platforms [platform list]
    echo if {[lsearch -exact $existing_platforms $plat_name] == -1} {
    echo     platform create -name $plat_name -hw $xsa_path
    echo     platform active $plat_name
    echo     bsp setosver standalone
    echo     domain create -name $bsp_proc -os standalone -proc $bsp_proc
    echo     platform generate
    echo } else {
    echo     platform active $plat_name
    echo }
    echo.
    echo # Create application
    echo if {[catch {app list} err]} {}
    echo set existing_apps [app list]
    echo if {[lsearch -exact $existing_apps $app_name] == -1} {
    echo     app create -name $app_name -template {Empty Application} -platform $plat_name -domain $bsp_proc
    echo     file copy -force $app_src $ws_dir/$app_name/src/
    echo }
    echo.
    echo # Build
    echo puts "Building $app_name ..."
    echo app build -name $app_name
    echo if {$build_only} { puts "BUILD_ONLY: done"; exit 0 }
    echo.
    echo # Connect and optionally program bitstream
    echo connect
    echo targets -set -filter {jtag_device_ctx ne ""} -index 0
    echo if {$prog_bit && [file exists $bit_file]} {
    echo     puts "Programming bitstream: $bit_file"
    echo     fpga -file $bit_file
    echo     after 2000
    echo }
    echo.
    echo # Select PS core
    echo targets -set -filter {name =~ "*A9*0" || name =~ "*A53*0"}
    echo rst -system
    echo after 500
    echo.
    echo # Load and run
    echo puts "Loading ELF..."
    echo dow $ws_dir/$app_name/Debug/${app_name}.elf
    echo puts "Running smoke test..."
    echo con
    echo after 30000
    echo stop
    echo.
    echo puts "=== Console output captured above ==="
    echo disconnect
    echo exit 0
) > "%TCL_SCRIPT%"

echo --- Building application ---
call "%XSCT%" "%TCL_SCRIPT%"
set BUILD_RC=%ERRORLEVEL%
del /f /q "%TCL_SCRIPT%" 2>nul

if %BUILD_RC% neq 0 (
    echo.
    echo ERROR: xsct exited with code %BUILD_RC%
    exit /b %BUILD_RC%
)

if "%BUILD_ONLY%"=="1" (
    echo.
    echo Build complete. ELF: %WS_DIR%\%APP_NAME%\Debug\%APP_NAME%.elf
    exit /b 0
)

echo.
echo === Done ===
echo   Look for SMOKE_GATE: PASS or SMOKE_GATE: FAIL in xsct output above.
echo   If no output: check JTAG connection and that the correct targets were selected.
echo.
exit /b 0
