# CLOCK-REGRESSION sweep harness. IDENTICAL to run_11_full_rx_loopback.xsct
# except PL0_REF_CTRL (pl_clk0) is taken from argv[1] (mwr value) so we can sweep
# the fabric clock with NO rebuild. argv[0]=label, argv[1]=mwr_hex (e.g. 0x01010800).
set repo_root [file normalize [file join [file dirname [info script]] ..]]
set label "run"
set clkval "0x01010800"
if {[info exists argv] && [llength $argv] >= 1} { set label  [lindex $argv 0] }
if {[info exists argv] && [llength $argv] >= 2} { set clkval [lindex $argv 1] }

set hw_dir   [file join $repo_root hardware generated 11_full_rx_loopback]
set ws       [file join $repo_root software generated rfdc_capture_ws]
set bit      [file join $hw_dir zcu216_fullrx.runs impl_1 system_wrapper.bit]
set psu_init [file join $hw_dir psu_init.tcl]
set elf      [file join $ws rfdc_capture Debug rfdc_capture.elf]
set tests_dir [file join $repo_root tests 11_full_rx_loopback]
file mkdir $tests_dir
set dump [file join $tests_dir frxbits_$label.bin]

set nm ""
foreach nm_glob [list \
    $env(HOME)/xilinx/Vitis/Vitis/*/gnu/aarch64/lin/aarch64-none/bin/aarch64-none-elf-nm \
    /tools/Xilinx/Vitis/*/gnu/aarch64/lin/aarch64-none/bin/aarch64-none-elf-nm] {
    foreach c [lsort -decreasing [glob -nocomplain $nm_glob]] {
        if {[file exists $c]} { set nm $c; break }
    }
    if {$nm ne ""} { break }
}

foreach f [list $bit $psu_init $elf] {
    if {![file exists $f]} { error "Missing prerequisite: $f" }
}

connect
targets -set -nocase -filter {name =~ "*PSU*"}
rst -system
after 1000

source $psu_init
psu_init
puts "ZCU216_CLKSWEEP: setting PL0_REF_CTRL 0xFF5E00C0 = $clkval"
mwr 0xFF5E00C0 $clkval
after 500
puts "ZCU216_CLKSWEEP: readback PL0_REF_CTRL = [mrd -value 0xFF5E00C0]"
fpga -file $bit
after 500
psu_ps_pl_isolation_removal
psu_ps_pl_reset_config
after 500

targets -set -nocase -filter {name =~ "*A53*#0"}
rst -processor -clear-registers
dow $elf
con
puts "ZCU216_FRX_APP: running; inspect UART0 for ZCU216_DLOOP: markers"

set addr 0
if {$nm ne ""} {
    catch {
        foreach line [split [exec $nm $elf] "\n"] {
            if {[lindex $line 2] eq "capture_buf"} { set addr 0x[lindex $line 0] }
        }
    }
}

after 30000

if {$addr ne 0} {
    targets -set -nocase -filter {name =~ "*A53*#0"}
    mrd -force -bin -file $dump $addr 16384
    puts "ZCU216_FRX_APP: capture_buf dumped addr=$addr file=$dump (16384 words, 5 frames)"
} else {
    puts "ZCU216_FRX_APP: WARN could not resolve capture_buf; skipped dump"
}
